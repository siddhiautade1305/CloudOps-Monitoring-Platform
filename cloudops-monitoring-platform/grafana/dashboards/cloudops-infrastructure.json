{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "-- Grafana --"
                },
                "enable": true,
                "hide": true,
                "iconColor": "#5794F2",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "type": "row",
            "title": "HOST METRICS",
            "id": 1,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "CPU Utilization",
            "description": "Percentage of CPU capacity currently being used.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Memory Utilization",
            "description": "Percentage of host memory currently in use.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Disk Utilization",
            "description": "Percentage of filesystem space currently used.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 9
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"}))",
                    "legendFormat": "{{instance}} {{mountpoint}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Network Receive Rate",
            "description": "Network traffic received by the host.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 9
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(instance) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Network Transmit Rate",
            "description": "Network traffic transmitted by the host.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 17
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "System Load",
            "description": "One-minute system load average.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 17
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "node_load1",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "type": "row",
            "title": "CONTAINER METRICS",
            "id": 8,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 25
            }
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Container CPU Usage",
            "description": "CPU consumption by Docker containers.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 26
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Container Memory Usage",
            "description": "Working memory used by each Docker container.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 26
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(name) (container_memory_working_set_bytes{name!=\"\"})",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "Container Network Receive",
            "description": "Network bytes received by Docker containers.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 34
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "Container Network Transmit",
            "description": "Network bytes transmitted by Docker containers.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 34
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by(name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 13,
            "type": "table",
            "title": "Container Status / Last Seen",
            "description": "Shows the latest timestamp at which cAdvisor observed each container.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 42
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "dateTimeAsIso"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "container_last_seen{name!=\"\"}",
                    "legendFormat": "{{name}}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "showHeader": true,
                "footer": {
                    "show": false
                }
            }
        },
        {
            "type": "row",
            "title": "PROMETHEUS HEALTH",
            "id": 14,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 50
            }
        },
        {
            "id": 15,
            "type": "stat",
            "title": "Target Availability / UP Status",
            "description": "Number of Prometheus scrape targets currently reporting UP.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 51
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum(up)",
                    "legendFormat": "UP targets",
                    "refId": "A"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto"
            }
        },
        {
            "id": 16,
            "type": "timeseries",
            "title": "Target UP Status",
            "description": "Availability status of each Prometheus scrape target. 1 means UP and 0 means DOWN.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 51
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "max": 1
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "up",
                    "legendFormat": "{{job}} - {{instance}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "cloudops",
        "infrastructure",
        "prometheus",
        "containers",
        "node-exporter",
        "cadvisor"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "CloudOps Infrastructure Monitoring",
    "uid": "cloudops-infrastructure",
    "version": 1
}